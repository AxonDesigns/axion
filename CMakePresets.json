{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "AX_BUILD_TESTS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    { "name": "debug",   "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release", "hidden": true, "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    {
      "name": "sanitize",
      "hidden": true,
      "cacheVariables": { "AX_SANITIZE": "address;undefined" }
    },
    {
      "name": "sanitize-thread",
      "hidden": true,
      "cacheVariables": { "AX_SANITIZE": "thread" }
    },
    {
      "name": "msvc",
      "hidden": true,
      "inherits": "base",
      "description": "Run from a shell with the MSVC environment loaded (vcvars64 or msvc-dev-cmd).",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": { "CMAKE_C_COMPILER": "cl" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "clang",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang" },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "gcc",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },

    { "name": "msvc-debug",    "displayName": "MSVC Debug",            "inherits": ["msvc", "debug"] },
    { "name": "msvc-release",  "displayName": "MSVC Release",          "inherits": ["msvc", "release"] },
    { "name": "clang-debug",   "displayName": "Clang Debug",           "inherits": ["clang", "debug"] },
    { "name": "clang-release", "displayName": "Clang Release",         "inherits": ["clang", "release"] },
    { "name": "clang-asan",    "displayName": "Clang Debug ASan+UBSan", "inherits": ["clang", "debug", "sanitize"] },
    { "name": "clang-tsan",    "displayName": "Clang Debug TSan",      "inherits": ["clang", "debug", "sanitize-thread"] },
    { "name": "gcc-debug",     "displayName": "GCC Debug",             "inherits": ["gcc", "debug"] },
    { "name": "gcc-release",   "displayName": "GCC Release",           "inherits": ["gcc", "release"] },
    { "name": "gcc-asan",      "displayName": "GCC Debug ASan+UBSan",  "inherits": ["gcc", "debug", "sanitize"] },
    {
      "name": "emscripten",
      "displayName": "Emscripten (base only, single-threaded)",
      "description": "Needs EMSDK set (emsdk_env). Builds the libraries only; tests are off.",
      "inherits": ["base", "release"],
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": { "AX_BUILD_TESTS": "OFF", "AX_WEB_THREADS": "OFF" }
    },
    {
      "name": "emscripten-tests",
      "displayName": "Emscripten tests in Node (single-threaded)",
      "description": "Needs EMSDK set (emsdk_env). Builds the tests too; ctest runs them in Node (the toolchain's CMAKE_CROSSCOMPILING_EMULATOR).",
      "inherits": "emscripten",
      "cacheVariables": { "AX_BUILD_TESTS": "ON", "AX_BUILD_EXAMPLES": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "msvc-debug",    "configurePreset": "msvc-debug" },
    { "name": "msvc-release",  "configurePreset": "msvc-release" },
    { "name": "clang-debug",   "configurePreset": "clang-debug" },
    { "name": "clang-release", "configurePreset": "clang-release" },
    { "name": "clang-asan",    "configurePreset": "clang-asan" },
    { "name": "clang-tsan",    "configurePreset": "clang-tsan" },
    { "name": "gcc-debug",     "configurePreset": "gcc-debug" },
    { "name": "gcc-release",   "configurePreset": "gcc-release" },
    { "name": "gcc-asan",      "configurePreset": "gcc-asan" },
    { "name": "emscripten",    "configurePreset": "emscripten" },
    { "name": "emscripten-tests", "configurePreset": "emscripten-tests" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "timeout": 120 }
    },
    {
      "name": "test-sanitize",
      "hidden": true,
      "inherits": "test-base",
      "environment": {
        "ASAN_OPTIONS": "abort_on_error=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "test-tsan",
      "hidden": true,
      "inherits": "test-base",
      "environment": { "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1" }
    },
    { "name": "msvc-debug",    "configurePreset": "msvc-debug",    "inherits": "test-base" },
    { "name": "msvc-release",  "configurePreset": "msvc-release",  "inherits": "test-base" },
    { "name": "clang-debug",   "configurePreset": "clang-debug",   "inherits": "test-base" },
    { "name": "clang-release", "configurePreset": "clang-release", "inherits": "test-base" },
    { "name": "clang-asan",    "configurePreset": "clang-asan",    "inherits": "test-sanitize" },
    { "name": "clang-tsan",    "configurePreset": "clang-tsan",    "inherits": "test-tsan" },
    { "name": "gcc-debug",     "configurePreset": "gcc-debug",     "inherits": "test-base" },
    { "name": "gcc-release",   "configurePreset": "gcc-release",   "inherits": "test-base" },
    { "name": "gcc-asan",      "configurePreset": "gcc-asan",      "inherits": "test-sanitize" },
    {
      "name": "emscripten-tests",
      "configurePreset": "emscripten-tests",
      "inherits": "test-base",
      "description": "The single-threaded build's tests in Node: core, the Render IR and the runtime's cooperative mode (decision 79).",
      "filter": { "include": { "label": "^(core|headless|render_ir|render_soft|runtime)$" }, "exclude": { "label": "^death$" } }
    }
  ]
}
