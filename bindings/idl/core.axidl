//
// AXION interface description: the core module's stable ABI (draft, M1).
//
// No tool reads this file yet. The generator arrives in M2 with the C# binding; until then the C
// headers in core/include/axion/ are written by hand and this file is kept in step with them, as
// the specification the generator will start from. Decision 71 describes the format.
//
// Only the stable ABI is described here. The internal SDK (core/include/axion/core/: node store,
// scene, registry, the scene thread's side of the queue, apply and publish) is hand-written C that
// no binding ever sees.

axidl 0.1;

module core {
    import base;  // result, str, allocator, handle

    // ---- Objects ------------------------------------------------------------------------------

    handle world;  // C: AX_DECLARE_HANDLE(ax_world). Bindings: a class whose methods check the
    handle node;   // generation; a stale handle raises instead of touching freed memory.
    opaque txn;    // C: struct ax_txn *. Short-lived, owned by one thread, ended by consumes().

    // ---- Values -------------------------------------------------------------------------------

    enum node_kind : u32 { view = 1; }
    enum unit : u32 { auto = 0; points = 1; percent = 2; }
    enum value_type : u32 { f32 = 1; dimension = 2; vec2 = 3; color = 4; transform2d = 5;
                            u32 = 6; bool = 7; /* 8 reserved: str */ }
    enum effect_class : u32 { layout = 1; paint = 2; composite = 3; }
    enum transition_kind : u32 { none = 1; timing = 2; spring = 3; }
    // Layout enumerations (decision 89); values fixed forever, stored in one byte.
    enum display : u32 { flex = 0; none = 1; }
    enum position : u32 { relative = 0; absolute = 1; static = 2; }
    enum overflow : u32 { visible = 0; hidden = 1; }
    enum box_sizing : u32 { border_box = 0; content_box = 1; }
    enum flex_direction : u32 { column = 0; column_reverse = 1; row = 2; row_reverse = 3; }
    enum flex_wrap : u32 { no_wrap = 0; wrap = 1; wrap_reverse = 2; }
    enum justify : u32 { flex_start = 0; center = 1; flex_end = 2; space_between = 3;
                         space_around = 4; space_evenly = 5; }
    enum align : u32 { auto = 0; flex_start = 1; center = 2; flex_end = 3; stretch = 4;
                       baseline = 5; space_between = 6; space_around = 7; space_evenly = 8; }
    flags prop_flags : u32 { inherited = 0x1; animatable = 0x2; shorthand = 0x4; }

    struct dimension { f32 value; unit unit; }
    struct vec2f { f32 x, y; }
    struct rgba { f32 r, g, b, a; }               // linear light, premultiplied (decision 50)
    struct transform2d { f32 a, b, c, d, tx, ty; } // CSS matrix() order
    struct rectf { f32 x, y, w, h; }

    // [extensible]: the generator prepends `u32 struct_size` and `const void *next`, and checks
    // struct_size on entry (AX_ERR_ABI_MISMATCH). Fields are only ever appended.
    [extensible]
    struct world_desc {
        allocator? allocator;   // thread-safe: used by the app and the scene threads
        clock_fn? clock;        // fn(user) -> u64 nanoseconds
        ptr clock_user;
    }

    [extensible, provisional]   // fields may change with animations, before the ABI freezes
    struct transition {
        transition_kind kind;
        f32 delay, duration;
        f32[4] curve;
        f32 bounce;
    }

    enum world_event_type : u32 { none = 0; close_requested = 1; resized = 2; scale_changed = 3;
                                  focus = 4; occlusion = 5; }
    enum presented_status : u32 { presented = 1; rejected = 2; world_destroyed = 3; }

    // [sized]: a leading `u32 struct_size` the caller sets (an out struct that may grow).
    [sized]
    struct world_event {
        world_event_type type;
        u64 window;     // the platform's ax_window handle value
        node? root;
        u64 time_ns;    // world clock
        union data by type {
            resized:       { f32 width, height; u32 pixel_width, pixel_height; f32 scale; }
            scale_changed: { f32 scale; }
            focus:         { bool focused; }
            occlusion:     { bool occluded; }
            reserved:      u64[8];
        }
    }

    // Called on the app thread from world_poll_event / world_wait_event / world_destroy.
    callback presented_fn(u64 seq, presented_status status, u64 present_time_ns);

    struct txn_error {
        u64 seq;
        result result;
        u32 command;
        [lifetime(next_call_on(world))] str message;
    }

    // ---- Properties ---------------------------------------------------------------------------
    // Each row generates the C enum value (AX_PROP_<NAME>), the registry's built-in row (type,
    // flags, effect, range, storage) and, in bindings, a typed accessor on transactions and, for
    // paint and composite properties, the mirror (layout inputs are not mirrored: the computed
    // frame is, decision 89): `t.Set(card, Prop.Width, 120.Points())` or
    // `card.Width = 120.Points()` in a builder. Enumerations are u32 on the wire.
    // Ids are fixed forever; core ids stay below 0x8000, kit ids come from kit's own .axidl files
    // in 0x8000-0xFFFF, plugins register theirs at run time.

    props {
        // id      name                          type         effect     flags        range
        0x0101  width                        : dimension   layout     [animatable] min(0);
        0x0102  height                       : dimension   layout     [animatable] min(0);
        0x0103  left                         : dimension   layout     [animatable];
        0x0104  top                          : dimension   layout     [animatable];
        0x0105  right                        : dimension   layout     [animatable];
        0x0106  bottom                       : dimension   layout     [animatable];
        0x0107  min_width                    : dimension   layout     [animatable] min(0);
        0x0108  min_height                   : dimension   layout     [animatable] min(0);
        0x0109  max_width                    : dimension   layout     [animatable] min(0);
        0x010A  max_height                   : dimension   layout     [animatable] min(0);
        0x010B  position                     : position    layout     default(relative);
        0x010C  display                      : display     layout     default(flex);
        0x010D  overflow                     : overflow    layout     default(visible);
        0x010E  aspect_ratio                 : f32         layout     [animatable] min(0);
        0x010F  box_sizing                   : box_sizing  layout     default(border_box);
        0x0110  flex_direction               : flex_direction layout  default(column);
        0x0111  flex_wrap                    : flex_wrap   layout     default(no_wrap);
        0x0112  flex_grow                    : f32         layout     [animatable] min(0);
        0x0113  flex_shrink                  : f32         layout     [animatable] min(0);
        0x0114  flex_basis                   : dimension   layout     [animatable] min(0);
        0x0115  justify_content              : justify     layout     default(flex_start);
        0x0116  align_items                  : align       layout     default(stretch);
        0x0117  align_self                   : align       layout     default(auto);
        0x0118  align_content                : align       layout     default(flex_start);
        0x0119  column_gap                   : dimension   layout     [animatable] min(0);
        0x011A  row_gap                      : dimension   layout     [animatable] min(0);
        0x011B  gap                          : dimension   layout     [animatable]
                shorthand(column_gap, row_gap);
        0x0120  margin_left                  : dimension   layout     [animatable] default(0pt);
        0x0121  margin_top                   : dimension   layout     [animatable] default(0pt);
        0x0122  margin_right                 : dimension   layout     [animatable] default(0pt);
        0x0123  margin_bottom                : dimension   layout     [animatable] default(0pt);
        0x0124  margin                       : dimension   layout     [animatable]
                shorthand(margin_left, margin_top, margin_right, margin_bottom);
        0x0128  padding_left                 : dimension   layout     [animatable] min(0);
        0x0129  padding_top                  : dimension   layout     [animatable] min(0);
        0x012A  padding_right                : dimension   layout     [animatable] min(0);
        0x012B  padding_bottom               : dimension   layout     [animatable] min(0);
        0x012C  padding                      : dimension   layout     [animatable]
                shorthand(padding_left, padding_top, padding_right, padding_bottom);
        0x0130  border_left_width            : f32         layout     [animatable] min(0);
        0x0131  border_top_width             : f32         layout     [animatable] min(0);
        0x0132  border_right_width           : f32         layout     [animatable] min(0);
        0x0133  border_bottom_width          : f32         layout     [animatable] min(0);
        0x0134  border_width                 : f32         layout     [animatable]
                shorthand(border_left_width, border_top_width, border_right_width,
                          border_bottom_width);
        0x0201  background_color             : color       paint      [animatable];
        0x0202  corner_radius_top_left       : f32         paint      [animatable] min(0);
        0x0203  corner_radius_top_right      : f32         paint      [animatable] min(0);
        0x0204  corner_radius_bottom_right   : f32         paint      [animatable] min(0);
        0x0205  corner_radius_bottom_left    : f32         paint      [animatable] min(0);
        0x0206  corner_radius                : f32         paint      [animatable]
                shorthand(corner_radius_top_left, corner_radius_top_right,
                          corner_radius_bottom_right, corner_radius_bottom_left);
        0x0301  opacity                      : f32         composite  [animatable] range(0, 1);
        0x0302  transform                    : transform2d composite  [animatable]
                origin(center);  // about the frame's center (decision 63)
    }

    // ---- Functions ----------------------------------------------------------------------------
    // [thread(...)]  where it may run: any, app, scene, render. Debug builds check it on entry.
    // [sticky(t)]    records into t; an error is kept in t and reported by its commit.
    // [consumes(t)]  ends t; bindings invalidate the object.
    // out params     become return values in bindings; a `result` becomes an exception or an error
    //                value, with ax_last_error()'s message.
    // `?`            may be null / optional.

    const u32 max_worlds = 256;  // at least this many worlds at once (a guaranteed minimum)
    [thread(any)]  fn world_create(world_desc? desc, out world world) -> result;
    [thread(app)]  fn world_destroy(world world) -> result;
    [thread(any)]  fn world_now(world world) -> u64;

    [thread(any)]  fn rgba_from_srgb(f32 r, f32 g, f32 b, f32 a) -> rgba;
    [thread(any)]  fn rgba_from_srgb8(u8 r, u8 g, u8 b, u8 a) -> rgba;

    [thread(app)]                      fn txn_begin(world world) -> txn?;
    [thread(app), sticky(t)]           fn txn_create(txn t, node_kind kind) -> node;
    [thread(app), sticky(t), setter]   fn txn_set_f32(txn t, node node, prop prop, f32 value);
    [thread(app), sticky(t), setter]   fn txn_set_dimension(txn t, node node, prop prop, dimension value);
    [thread(app), sticky(t), setter]   fn txn_set_vec2(txn t, node node, prop prop, vec2f value);
    [thread(app), sticky(t), setter]   fn txn_set_color(txn t, node node, prop prop, rgba value);
    [thread(app), sticky(t), setter]   fn txn_set_transform(txn t, node node, prop prop, transform2d value);
    [thread(app), sticky(t), setter]   fn txn_set_u32(txn t, node node, prop prop, u32 value);
    [thread(app), sticky(t), setter]   fn txn_set_bool(txn t, node node, prop prop, bool value);
    [thread(app), sticky(t)]           fn txn_append_child(txn t, node parent, node child);
    [thread(app), sticky(t)]           fn txn_insert_before(txn t, node parent, node child, node? before);
    [thread(app), sticky(t)]           fn txn_remove(txn t, node node);
    [thread(app), sticky(t)]           fn txn_set_animated(txn t, bool animated);
    [thread(app), sticky(t)]           fn txn_set_transition(txn t, node node, prop prop, transition transition);
    [thread(app), consumes(t)]         fn txn_commit(txn t, out u64? seq) -> result;
    [thread(app), consumes(t)]         fn txn_abort(txn t);

    [thread(app)]  fn world_poll_txn_error(world world, out txn_error error, out u32? dropped) -> bool;
    [thread(app)]  fn world_last_applied_seq(world world) -> u64;
    [thread(app)]  fn world_last_committed_seq(world world) -> u64;
    const u32 txn_error_queue = 64;

    [thread(app)]  fn world_poll_event(world world, out world_event event) -> result;
    [thread(app)]  fn world_wait_event(world world, out world_event event, u64 timeout_ns) -> result;
    // Always called once; bindings turn it into a task/future completed with the status.
    [thread(app)]  fn txn_on_presented(world world, u64 seq, presented_fn fn) -> result;
    const u32 txn_presented_window = 1024;

    [thread(app)]          fn world_mirror_sync(world world) -> u64;
    [thread(app)]          fn mirror_is_live(world world, node node) -> bool;
    [thread(app)]          fn mirror_parent(world world, node node) -> node?;
    [thread(app), getter]  fn mirror_get_f32(world world, node node, prop prop, out f32 value) -> result;
    [thread(app), getter]  fn mirror_get_dimension(world world, node node, prop prop, out dimension value) -> result;
    [thread(app), getter]  fn mirror_get_color(world world, node node, prop prop, out rgba value) -> result;
    [thread(app), getter]  fn mirror_get_transform(world world, node node, prop prop, out transform2d value) -> result;
    [thread(app)]          fn mirror_get_frame(world world, node node, out rectf frame) -> result;
}
